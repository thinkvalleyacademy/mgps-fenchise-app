# Copy this file to .env in the same folder on the Linux server.

# Must match APP_LOG_DIR in docker-files/application/production/.env — this
# is the host directory the app writes logs to, mounted read-only here so
# Filebeat can tail it.
APP_LOG_DIR=/var/log/mgps

# Ports published to the host. Only these two UIs are exposed; Prometheus,
# MongoDB, OpenSearch and the Filebeat->Graylog pipeline stay on the internal
# monitoring network only.
GRAFANA_PORT=3000
GRAYLOG_PORT=9000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-admin-password

# Graylog settings — see README.md "Generating Graylog secrets" for how to
# produce these two values. Graylog refuses to start without them.
GRAYLOG_PASSWORD_SECRET=
GRAYLOG_ROOT_PASSWORD_SHA2=

# The URL Graylog advertises to itself and to your browser. Use the address
# you'll actually open Graylog from.
GRAYLOG_HTTP_EXTERNAL_URI=http://YOUR_SERVER_IP:9000/

# JVM heap for OpenSearch. Keep Xms == Xmx. Raise if you have log volume to
# match; this is a single-node, log-storage-only instance, not a search
# cluster, so it doesn't need much by default.
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
