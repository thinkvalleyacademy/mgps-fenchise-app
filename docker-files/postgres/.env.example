# Copy to .env in this folder only if you want to override the defaults below.
# Postgres is shared infrastructure — every app environment on this server
# (prod, dev, ...) connects to this ONE instance, isolated from each other
# only by DB_NAME. There should normally be only one of these running per
# server, so this rarely needs a real .env file at all.

# Network name every app environment's compose file also references as
# DB_NETWORK_NAME. Must be created once, manually, before first use:
#   docker network create mgps-shared
DB_NETWORK_NAME=mgps-shared
